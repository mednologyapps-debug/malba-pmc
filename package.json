{
  "name": "malba-pmc",
  "version": "1.0.0",
  "private": true,
  "description": "MALBA PMC web, CMS y aula virtual",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "build": "node -e \"console.log('MALBA PMC Node build listo')\"",
    "dev": "node server.js",
    "start": "node server.js",
    "check": "node --check server.js",
    "test:node": "node --test tests/node-*.test.js",
    "seo:audit": "python scripts/seo_audit.py",
    "seo:release": "python scripts/seo_release.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "exceljs": "4.4.0",
    "nodemailer": "10.2.1",
    "ws": "8.22.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
